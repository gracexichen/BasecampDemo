# Copy this file to .env and fill in values. Never commit .env.
#
# Anthropic API key for live Claude extraction. Create one at
# https://platform.claude.com (an API key is separate from a Claude Enterprise login).
# Leave blank to use the offline demonstration mode only.
ANTHROPIC_API_KEY=

# Optional: model used for extraction (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: backend port (default 8787). The web app runs on 5173.
# API_PORT=8787
